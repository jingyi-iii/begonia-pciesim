# Nothing generated by a build or a simulation belongs in the repository.
# Some of it (tb/results.xml) even embeds the absolute paths of the machine it
# was produced on, so a shared checkout must not carry it.

# Verilator + cocotb build directory (run.py builds into sim_build/) and the
# HTML report rendered from it.
sim_build/
report/

# Waveforms (`make waves`) and the JUnit XML (`make sim`). The explicit paths
# are the ones the demo writes; the wildcards catch a dump left behind by a
# hand-run Verilator or by another simulator (GHDL, Icarus).
tb/dump.vcd
tb/results.xml
*.vcd
*.fst

# `make rtl` output: generated from the LitePCIe sources, never edited by hand.
rtl/litepcie_tlp_packetizer.v
rtl/litepcie_tlp_packetizer.ports.json

# The optional self-contained toolchain, several GB, built by `setup-env.sh`.
# By default it lives *outside* this checkout -- env.sh looks for
# $LITEPCIE_DEMO_TOOLS and then ../.tools -- so this rule is a safety net for
# the cases where it does land inside: a checkout that keeps its toolchain
# in-tree, or an LITEPCIE_DEMO_TOOLS pointing at one. Note that a .gitignore is
# resolved relative to the directory it sits in, so if you start the repository
# one level up you need the rule there too, not here.
.tools/

# Third-party sources: ~1.6 MB of unpacked upstream LitePCIe. `make vendor`
# recreates it on demand from the pinned tarball in cache/, which *is* tracked,
# so a fresh clone still bootstraps without network access.
#
# Delete the line below to commit the unpacked tree instead -- that pins the
# upstream version explicitly in the history, at the cost of the larger checkout.
vendor/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
